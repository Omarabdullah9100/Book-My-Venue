# Email (M7) — "console" prints emails to the server log
EMAIL_PROVIDER="console"
RESEND_API_KEY=""

# Storage (M3) — "local" writes to ./uploads
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Jobs: shared secret for the cron endpoints (M4)
CRON_SECRET=""

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
