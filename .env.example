# Database
DATABASE_URL="postgresql://idam:idam@localhost:5432/idam?schema=public"

# Auth (M1)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# "mock" logs OTP codes to the server console. Never use mock in production.
SMS_PROVIDER="mock"
SMS_PROVIDER_API_KEY=""

# Payments (M5) — Razorpay TEST mode keys only
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
